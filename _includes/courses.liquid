<div class="col">
  <a href="{{ course.url | relative_url }}">
    <div class="card h-100 hoverable">
      <div class="card-body">
        <div class="mb-2" style="font-size: 1.5rem; color: var(--global-theme-color);">
          <i class="fa-solid {{ course.icon | default: 'fa-book-open' }}"></i>
        </div>
        <h2 class="card-title">{{ course.title }}</h2>
        <p class="card-text">{{ course.description }}</p>
        <div>
          {% for tag in course.tags %}
            <span class="badge badge-light text-uppercase mr-1 mb-1" style="font-size: 0.65rem; letter-spacing: 0.04em;">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
      <div class="card-footer">
        <span class="small">Materi pembelajaran →</span>
      </div>
    </div>
  </a>
</div>
