{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
      {% if site.enable_visitor_counter %}
        <span class="visitor-counter small text-muted ms-2">
          <i class="fa-solid fa-eye"></i>
          <span id="vercount_value_page_pv">--</span> views · <span id="vercount_value_site_uv">--</span> visitors
          <span id="busuanzi_value_site_pv" style="display: none"></span><span id="busuanzi_value_site_uv" style="display: none"></span>
        </span>
      {% endif %}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
      {% if site.enable_visitor_counter %}
        <div class="visitor-counter small text-muted mt-1">
          <i class="fa-solid fa-eye"></i>
          <span id="vercount_value_page_pv">--</span> views · <span id="vercount_value_site_uv">--</span> visitors
          <span id="busuanzi_value_site_pv" style="display: none"></span><span id="busuanzi_value_site_uv" style="display: none"></span>
        </div>
      {% endif %}
    </div>
  </footer>
{% endif %}
{% if site.enable_visitor_counter %}
  <script defer src="https://cn.vercount.one/js"></script>
  <script async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
{% endif %}
